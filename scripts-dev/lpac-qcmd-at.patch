+static int at_qcmd(const char *command, char **response, const char *expected)
+{
+    char shell[AT_BUFFER_SIZE + 64];
+    char line[AT_BUFFER_SIZE];
+
+    if (response)
+        *response = NULL;
+    if (strchr(command, '\'') != NULL)
+        return -1;
+
+    snprintf(shell, sizeof(shell),
+             "QCMD_WAIT_MS=30000 qcmd '%s' 2>/dev/null", command);
+    FILE *q = popen(shell, "r");
+    if (q == NULL)
+        return -1;
+
+    int result = 0;
+    while (fgets(line, sizeof(line), q))
+    {
+        line[strcspn(line, "\r\n")] = 0;
+        if (strcmp(line, "ERROR") == 0)
+        {
+            result = -1;
+            break;
+        }
+        if (strcmp(line, "OK") == 0)
+        {
+            result = 0;
+            break;
+        }
+        if (expected && strncmp(line, expected, strlen(expected)) == 0)
+        {
+            if (response)
+                *response = strdup(line + strlen(expected));
+        }
+    }
+    pclose(q);
+    return result;
+}
+
+static int at_command(const char *command, char **response, const char *expected)
+{
+    if (use_qcmd)
+        return at_qcmd(command, response, expected);
+
+    fprintf(fuart, "%s\r\n", command);
+    return at_expect(response, expected);
+}
